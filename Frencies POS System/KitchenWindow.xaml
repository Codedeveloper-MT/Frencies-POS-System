<Window x:Class="Frencies_POS_System.KitchenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frencies_POS_System"
        mc:Ignorable="d"
        Title="KitchenWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">

            <!-- Right side: delete by ticket number -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Ticket #"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Margin="0,0,6,0"/>
                <TextBox x:Name="txtTicket"
                         Width="90" Height="32"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         MaxLength="9"/>
                <Button x:Name="btnDelete"
                        Content="Delete Order"
                        Width="110" Height="32"
                        Margin="8,0,0,0"
                        Click="btnDelete_Click"/>
            </StackPanel>

            <!-- Left side: load orders + count -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="btnCustomerOrders"
                        Content="Customer Orders"
                        Width="160" Height="36"
                        FontSize="14" FontWeight="SemiBold"
                        Click="btnCustomerOrders_Click"/>
                <TextBlock x:Name="txtCount"
                           Margin="15,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Text="Press the button to load saved orders."/>
            </StackPanel>
        </DockPanel>

        <!-- All saved orders -->
        <DataGrid x:Name="dgOrders"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F3F3F3"
                  HeadersVisibility="Column"
                  SelectionChanged="dgOrders_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ticket" Binding="{Binding Ticket}" Width="70"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="170"/>
                <DataGridTextColumn Header="Payment" Binding="{Binding PayMethod}" Width="120"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="80"/>
                <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom bar -->
        <Button x:Name="btnBack"
                Grid.Row="2"
                Content="Back"
                Width="100" Height="32"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="btnBack_Click"/>
    </Grid>
</Window>