<Window x:Class="Frencies_POS_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frencies_POS_System"
        mc:Ignorable="d"
        Title="Frenics Menu Items" Height="750" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1E2422" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Frencis Supermarket" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Tasty takeaway · Ga-Rankuwa, Gauteng · all prices in ZAR" Foreground="#A9B3AD" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Order kiosk" Width="110" Height="36" FontWeight="Bold"
                            Background="#F2C14E" Foreground="#1E2422" Margin="0,0,8,0"/>
                    <Button Content="Kitchen screen" Width="120" Height="36"
                            Background="#1E2422" Foreground="White" Click="Button_Click_1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Menu items -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2" Margin="10">

                <StackPanel Margin="10">
                    <Image x:Name="myImage1" Source="/image/Image1.png" Height="150" Stretch="Fill"/>
                    <Label Content="Mega Pizza - R150.00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <Image x:Name="myImage4" Source="/image/Image4.png" Height="150" Stretch="Fill"/>
                    <Label Content="Mega Chicken - R138.00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <Image x:Name="myImage2" Source="/image/Image2.png" Height="150" Stretch="Fill"/>
                    <Label Content="Big Mac Burger - R60.00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <Image x:Name="myImage5" Source="/image/Image5.png" Height="150" Stretch="Fill"/>
                    <Label Content="Kasi Kota - R38.00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <Image x:Name="myImage3" Source="/image/Image3.png" Height="150" Stretch="Fill"/>
                    <Label Content="Family Fried - R230.00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <Image x:Name="myImage6" Source="/image/Image6.png" Height="150" Stretch="Fill"/>
                    <Label Content="Family Meal - R110.00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

            </UniformGrid>
        </ScrollViewer>

        <!-- Order panel -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,20,10">

            <Label Content="Please select an item:" FontSize="20" FontWeight="Bold"/>
            <Border Background="LightGray" Padding="15">
                <StackPanel>
                    <CheckBox x:Name="chkMegaPizza"    Content="Mega Pizza"     FontSize="20" Margin="0,5" Checked="chkMegaPizza_Checked"/>
                    <CheckBox x:Name="chkMegaChicken"  Content="Mega Chicken"   FontSize="20" Margin="0,5" Checked="chkMegaChicken_Checked"/>
                    <CheckBox x:Name="chkKasiKota"     Content="Kasi Kota"      FontSize="20" Margin="0,5" Checked="chkKasiKota_Checked"/>
                    <CheckBox x:Name="chkBigMacBurger" Content="Big Mac Burger" FontSize="20" Margin="0,5" Checked="chkMegaBurger_Checked"/>
                    <CheckBox x:Name="chkFamilyMeal"   Content="Family Meal"    FontSize="20" Margin="0,5" Checked="chkFimailyMeal_Checked"/>
                    <CheckBox x:Name="chkFamilyFried"  Content="Family Fried"   FontSize="20" Margin="0,5" Checked="chkFimalyFried_Checked"/>
                </StackPanel>
            </Border>

            <Label Content="Your order" FontSize="20" FontWeight="Bold" Margin="0,15,0,0"/>
            <Border Background="LightGray" Padding="15">
                <StackPanel>

                    <!-- Row 1 -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <!-- Row 2 -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="" FontSize="16"/>

                        <Button Content="View My Order" Grid.ColumnSpan="4" Margin="10,0,0,0" Click="btnViewOrders_clicked"/>
                    </Grid>

                    <!-- Total -->
                    <Grid Margin="0,10"/>
                    <Button Content="Clear order" Height="30" Margin="0,8,0,0" Click="Button_Click"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>