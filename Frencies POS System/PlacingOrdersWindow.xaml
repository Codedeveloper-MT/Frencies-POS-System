<Window x:Class="Frencies_POS_System.PlacingOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frencies_POS_System"
        mc:Ignorable="d"
        Title="Placing Orders Ticket" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="40" VerticalAlignment="Center">

            <Label Content="Your order number and pay" FontSize="22"
                   HorizontalAlignment="Center"/>

            <TextBlock x:Name="txtOrderNumber" Text=" " FontSize="64" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10,0,10"/>

            <TextBlock x:Name="txtPayMessage"
                       Text="R0.00"
                       FontSize="18" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,0,0,30" Height="32" Width="720"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnSendSlip" Content="Continue"
                        Width="230" Height="45" FontSize="16" Margin="0,0,20,0" Click="btnSendSlip_Click"/>
                <Button x:Name="btnNewOrder" Content="Start a new order"
                        Width="180" Height="45" FontSize="16" Click="btnNewOrder_Click_1"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>